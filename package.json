{
  "name": "columngrab",
  "version": "1.1.0",
  "private": true,
  "description": "Chrome extension that copies a single HTML table column to the clipboard.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "watch": "node scripts/build.ts --watch",
    "package": "npm run build && node scripts/package.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@oxlint/plugins": "1.93.0",
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.78.0",
    "oxlint": "1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
